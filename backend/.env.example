# Gemini API Key (if MODEL_PROVIDER="gemini")
# GEMINI_API_KEY=
# Google Search Configuration (used by LangChain GoogleSearchAPIWrapper)
# GOOGLE_CSE_ID="YOUR_GOOGLE_CUSTOM_SEARCH_ENGINE_ID"
# GOOGLE_API_KEY="YOUR_GOOGLE_API_KEY_FOR_SEARCH" # Can be the same as GEMINI_API_KEY if it has Search API enabled

# Model Provider: "gemini", "ollama", or "azure_openai"
MODEL_PROVIDER="gemini"

# Ollama Configuration (if MODEL_PROVIDER="ollama")
# OLLAMA_API_BASE_URL="http://localhost:11434/v1"
# OLLAMA_MODEL_NAME="llama3"

# Azure OpenAI Configuration (if MODEL_PROVIDER="azure_openai")
# AZURE_OPENAI_API_BASE_URL="YOUR_AZURE_OPENAI_ENDPOINT"
# AZURE_OPENAI_API_VERSION="YOUR_AZURE_API_VERSION"
# AZURE_OPENAI_DEPLOYMENT_NAME="YOUR_AZURE_DEPLOYMENT_NAME"
# AZURE_OPENAI_API_KEY="YOUR_AZURE_OPENAI_API_KEY"